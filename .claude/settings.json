{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Edit(/research/preregistration.yaml)",
      "Read(/data/holdout)",
      "Read(/data/holdout/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/vault_guard.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/prereg_guard.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_on_edit.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/test_gate.py"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
